# Single entry point: route /api and /auth to backend, everything else to frontend.
# Upstream hostnames are set by env: UPSTREAM_API (default plane-api), UPSTREAM_WEB (default plane-web).

server {
    listen 80;
    server_name _;

    client_max_body_size 100M;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location ~ ^/auth(/|$) {
        proxy_pass http://${UPSTREAM_API}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Served-By "plane-proxy-api";
    }

    location ~ ^/api(/|$) {
        proxy_pass http://${UPSTREAM_API}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Served-By "plane-proxy-api";
    }

    location / {
        proxy_pass http://${UPSTREAM_WEB}:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        add_header X-Served-By "plane-proxy-web";
    }
}
